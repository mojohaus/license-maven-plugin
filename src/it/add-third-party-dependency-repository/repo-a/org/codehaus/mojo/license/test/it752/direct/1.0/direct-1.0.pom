<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>org.codehaus.mojo.license.test.it752</groupId>
  <artifactId>direct</artifactId>
  <version>1.0</version>
  <packaging>pom</packaging>

  <name>Direct</name>

  <licenses>
    <license>
      <name>Direct License</name>
    </license>
  </licenses>

  <!-- "hidden" lives only here, in a repository the project does not know; the cloned IT is the working directory -->
  <repositories>
    <repository>
      <id>repo-b</id>
      <url>file://${user.dir}/repo-b</url>
      <releases>
        <enabled>true</enabled>
      </releases>
      <snapshots>
        <enabled>false</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencies>
    <dependency>
      <groupId>org.codehaus.mojo.license.test.it752</groupId>
      <artifactId>hidden</artifactId>
      <version>1.0</version>
      <type>pom</type>
    </dependency>
  </dependencies>
</project>
